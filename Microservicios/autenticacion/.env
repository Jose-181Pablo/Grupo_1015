# Clave para firmar los tokens JWT: texto Base64 de al menos 32 bytes (256 bits).
# Para generar una en PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=AtLdDVtUIAxuonEB89+NWSfDAb6TadbW8nkf417EULY=
JWT_EXPIRACION_MINUTOS=60

# Primer administrador: se crea al arrancar si no existe ningun ADMIN
# (el microservicio usuario debe estar encendido para crear su perfil).
ADMIN_CORREO=admin@grupo1015.com
ADMIN_PASSWORD=liz123
