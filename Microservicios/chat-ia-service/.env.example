# Copia este archivo como .env y llena los valores.
# Este .env sí se sube al repositorio (es privado). La clave de Gemini va aparte en gemini.env.

DB_PASSWORD=contraseña_del_usuario_chat_user
DB_ROOT_PASSWORD=contraseña_del_usuario_root
GEMINI_MODEL=gemini-flash-latest

# URLs de los microservicios de catálogo (rama pablo).
# Dentro de Docker usa host.docker.internal para llegar a tu equipo.
INMUEBLES_URL=http://host.docker.internal:8083
TERRENOS_URL=http://host.docker.internal:8084
