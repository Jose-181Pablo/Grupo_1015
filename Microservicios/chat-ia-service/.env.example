# Copia este archivo como .env y llena los valores.
# El archivo .env no se sube al repositorio.

DB_PASSWORD=contraseña_del_usuario_chat_user
DB_ROOT_PASSWORD=contraseña_del_usuario_root
GOOGLE_API_KEY=tu_clave_de_gemini
GEMINI_MODEL=gemini-flash-latest

# URL del microservicio de catálogo (inmobiliaria-service).
# Dentro de Docker: http://host.docker.internal:8082
CATALOGO_URL=http://host.docker.internal:8082
