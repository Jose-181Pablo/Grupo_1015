{
  "info": {
    "name": "chat-ia-service",
    "description": "Microservicio de chat con IA de Grupo 10.15. Ejecuta las peticiones en orden: la primera guarda el id de la conversación en la variable conversacionId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "conversacionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Estado del servicio",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear conversación",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/conversaciones",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "conversaciones"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuarioId\": \"aldoxd\",\n  \"propiedadId\": \"lago_nogal\",\n  \"titulo\": \"Consulta sobre Lago Nogal\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"conversacionId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Enviar mensaje",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/conversaciones/{{conversacionId}}/mensajes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "conversaciones",
            "{{conversacionId}}",
            "mensajes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pregunta\": \"¿Qué información tienes disponible sobre esta propiedad?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Trae respuesta del asistente\", () => pm.expect(pm.response.json().respuestaAsistente.contenido).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar conversación",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/conversaciones/{{conversacionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "conversaciones",
            "{{conversacionId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar conversaciones de un usuario",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/conversaciones?usuarioId=usuario-1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "conversaciones"
          ],
          "query": [
            {
              "key": "usuarioId",
              "value": "usuario-1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Error: pregunta vacía",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/conversaciones/{{conversacionId}}/mensajes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "conversaciones",
            "{{conversacionId}}",
            "mensajes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pregunta\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Eliminar conversación",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/conversaciones/{{conversacionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "conversaciones",
            "{{conversacionId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Error: conversación inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/conversaciones/{{conversacionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "conversaciones",
            "{{conversacionId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
