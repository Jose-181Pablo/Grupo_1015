# Copia este archivo como .env y llena los valores.
# El archivo .env no se sube al repositorio.

DB_PASSWORD=contraseña_del_usuario_suscripcion_user
DB_ROOT_PASSWORD=contraseña_del_usuario_root

# URL del microservicio de autenticación (rama liz).
# Si autenticación corre en Docker (red grupo1015): http://autenticacion:8082
# Si corre en IntelliJ en tu equipo:               http://host.docker.internal:8082
AUTENTICACION_URL=http://autenticacion:8082

# Cuenta de servicio con rol ADMIN en autenticación.
# Se usa para poner las cuentas en PREMIUM o regresarlas a ESTANDAR.
AUTENTICACION_CORREO=suscripcion@grupo1015.com
AUTENTICACION_PASSWORD=contraseña_de_la_cuenta_de_servicio
