        {
          "name": "7. Actualizar (apartado y nuevo precio)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Quedó APARTADA', () => pm.expect(pm.response.json().estatus).to.eql('APARTADA'));"
                ]
              }
