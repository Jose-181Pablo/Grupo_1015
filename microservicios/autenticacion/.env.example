# Plantilla de variables. Copia este archivo como ".env" y escribe tus propios valores.
# El archivo .env NO se sube a GitHub (esta en .gitignore).
DB_NAME=autenticacion_db
DB_USER=autenticacion
DB_PASSWORD=cambia_esta_contrasena
DB_ROOT_PASSWORD=cambia_esta_contrasena_root

# Clave para firmar los tokens JWT: texto Base64 de al menos 32 bytes (256 bits).
# Para generar una en PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=pega_aqui_tu_clave_base64
JWT_EXPIRACION_MINUTOS=60
